      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#171717" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2E2E2E" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1F1F1F" />
      <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#FAFAFA" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FAFAFA" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FAFAFA" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#666666" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#666666" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#171717" />
