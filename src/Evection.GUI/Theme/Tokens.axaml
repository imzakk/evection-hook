  </ResourceDictionary.ThemeDictionaries>

  <!-- Typography: Geist + Geist Mono (SIL OFL) -->
  <FontFamily x:Key="Geist">avares://EvectionHook/Assets/Fonts#Geist</FontFamily>
  <FontFamily x:Key="GeistMono">avares://EvectionHook/Assets/Fonts#Geist Mono</FontFamily>

  <!-- Radius -->
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusXl">12</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

  <!-- Effects -->
  <BoxShadows x:Key="ShadowSm">0 1 2 0 #0A000000, 0 0 0 1 #14000000</BoxShadows>
  <BoxShadows x:Key="ShadowMd">0 2 4 0 #0A000000, 0 8 16 -4 #0A000000, 0 0 0 1 #14000000</BoxShadows>
  <BoxShadows x:Key="ShadowLg">0 4 8 0 #0A000000, 0 16 24 -8 #0F000000, 0 0 0 1 #14000000</BoxShadows>
  <BoxShadows x:Key="FocusRing">0 0 0 3 #3D0070F3</BoxShadows>

  <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
</ResourceDictionary>
