<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Evection.GUI.ViewModels"
             xmlns:c="using:Evection.GUI.Controls"
             x:Class="Evection.GUI.Views.Pages.CodeBrowserPage"
             x:DataType="vm:CodeBrowserPageViewModel">
  <DockPanel Margin="32,8,32,24">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <CheckBox Theme="{StaticResource Switch}" Content="include unity and libraries" IsChecked="{Binding IncludeLibraries}" FontSize="13" />
        <Button Classes="small" Command="{Binding ExportCommand}" IsEnabled="{Binding IsLoaded}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="download" IsVisible="{Binding !IsExporting}" />
            <c:Icon Kind="loader" Classes="spin" IsVisible="{Binding IsExporting}" />
            <TextBlock Text="export project" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock Classes="h32" Text="code browser" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
      <ComboBox Width="340" MinHeight="40" FontSize="14" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" PlaceholderText="choose a game">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:GameItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:GameImage Game="{Binding Info}" Kind="Icon" Width="20" Height="20" CornerRadius="3" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock Classes="mono12 tertiary" Text="{Binding BackendText}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsLoading}" VerticalAlignment="Center">
        <c:Icon Kind="loader" Classes="spin" Foreground="{DynamicResource TextTertiary}" />
        <TextBlock Classes="copy13 tertiary" Text="{Binding LoadingText}" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <Panel>
      <Border Classes="card" Padding="40" VerticalAlignment="Top" IsVisible="{Binding !IsLoaded}">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Classes="h16" Text="pick a game" HorizontalAlignment="Center" />
          <TextBlock Classes="copy14 secondary" HorizontalAlignment="Center" Text="then search for things like health, money or speed." />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="340,16,*" IsVisible="{Binding IsLoaded}">
        <DockPanel Grid.Column="0">
          <TextBox DockPanel.Dock="Top" Watermark="search" Text="{Binding Query}">
            <TextBox.InnerLeftContent>
              <c:Icon Kind="search" Foreground="{DynamicResource TextTertiary}" Margin="0,0,-4,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding SearchMode}" Padding="0" Margin="0,8,0,0">
            <TabItem Header="classes" FontSize="13" />
            <TabItem Header="fields &amp; methods" FontSize="13" />
          </TabControl>
          <TextBlock DockPanel.Dock="Bottom" Classes="mono12 tertiary" Text="{Binding ResultsText}" Margin="4,8,0,0" />
          <ListBox Classes="plain" Margin="0,8,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:CodeResultViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <c:Icon Kind="{Binding Icon}" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Top" Margin="0,2,0,0" />
                  <StackPanel Width="280">
                    <TextBlock Classes="copy14" Text="{Binding Title}" />
                    <TextBlock Classes="mono12 tertiary" Text="{Binding Subtitle}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="2">
          <Border DockPanel.Dock="Top" Classes="callout info" Margin="0,0,0,12" IsVisible="{Binding SignaturesOnly}">
            <TextBlock Classes="copy13" Text="il2cpp game: you get names and signatures, but not what the methods do." />
          </Border>
          <Panel>
            <Border Classes="card" Padding="32" VerticalAlignment="Top" IsVisible="{Binding !HasSelection}">
              <TextBlock Classes="copy14 secondary" HorizontalAlignment="Center" Text="select something on the left." />
            </Border>
            <TabControl SelectedIndex="{Binding DetailTab}" Padding="0,12,0,0" IsVisible="{Binding HasSelection}">
              <TabItem Header="outline">
                <Border Classes="code">
                  <DockPanel>
                    <Button DockPanel.Dock="Top" Classes="small tertiary" HorizontalAlignment="Right" Margin="0,8,8,0" Command="{Binding CopySourceCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="copy" /><TextBlock Text="copy" /></StackPanel>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                      <SelectableTextBlock Classes="code" Text="{Binding Outline}" Margin="16,0,16,16" />
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </TabItem>
              <TabItem Header="source">
                <Border Classes="code">
                  <DockPanel>
                    <Button DockPanel.Dock="Top" Classes="small tertiary" HorizontalAlignment="Right" Margin="0,8,8,0" Command="{Binding CopySourceCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="copy" /><TextBlock Text="copy" /></StackPanel>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                      <SelectableTextBlock Classes="code" Text="{Binding Source}" Margin="16,0,16,16" />
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </TabItem>
            </TabControl>
          </Panel>
        </DockPanel>
      </Grid>
    </Panel>
  </DockPanel>
</UserControl>
